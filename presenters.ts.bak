export interface Presenter {
  slug: string
  name: string
  /** Short show name, e.g. "The Lunch Hive" */
  showName: string
  /** Full broadcast title, also used to build the on-demand URL */
  showTitle: string
  /** Human readable slot, e.g. "Weekdays 12pm – 3pm" */
  slotLabel: string
  shortBio: string
  bio: string[]
  image?: string
}

export function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[’']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')
}

export function onDemandSlug(presenter: Presenter): string {
  return slugify(presenter.showTitle)
}

const placeholderBio = (name: string, show: string, slot: string) => [
  `${name} presents ${show} on Hive FM, ${slot.toLowerCase()}. Tune in for great music, local chat and a warm welcome from your community radio station in Grantham.`,
  'A full biography is coming soon.',
]

